#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$DIR/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
if [ "$(id -u)" -ne 0 ]; then
    exec sudo -E env PATH="$PATH" TERM="${TERM:-xterm-256color}" "$PY" "$DIR/main.py" "$@"
fi
exec "$PY" "$DIR/main.py" "$@"
